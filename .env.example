# ---- Backend environment template ----
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Auth — use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="24h"

# Server
PORT=3000
NODE_ENV=production

# Allowed CORS origin (your deployed frontend URL).
CORS_ORIGIN="https://your-frontend-domain.com"

# Uploaded images. Set to a PERSISTENT path/volume outside the deploy dir
# so images survive re-deploys. Defaults to <backend>/uploads if unset.
UPLOAD_DIR="/var/www/portfolio-uploads"

# Max upload size in bytes (default 5 MB).
MAX_FILE_SIZE=5242880

# First-run admin seed (only used when the users table is empty).
# If ADMIN_PASSWORD is omitted, a random one is generated and printed once.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="set-a-strong-password"

# --- Lead notification email (SMTP) ---
# When set, new contact-form leads are emailed to LEAD_NOTIFY_TO.
# Leads are always saved to the DB regardless; email is a best-effort extra.
SMTP_HOST=server193.iseencloud.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@sanket-jagtap.in
SMTP_PASS=
SMTP_FROM=contact@sanket-jagtap.in
LEAD_NOTIFY_TO=contact@sanket-jagtap.in
